<?xml version="1.0" encoding="utf-8"?>
<!-- An immersive device card: the whole card is a dark scene lit by the device's state, with the picture
     of the device edge to edge, its main control below, and chips plus "Open" at the bottom. -->
<UserControl
    x:Class="HomeControl.Controls.DeviceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HomeControl.Controls"
    RequestedTheme="Dark">
    <Grid CornerRadius="16" BorderBrush="#14FFFFFF" BorderThickness="1">
        <Border x:Name="BaseLayer">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#3A3B3F" />
                    <GradientStop Offset="0.55" Color="#26272B" />
                    <GradientStop Offset="1" Color="#1C1D20" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="GlowLayer" />

        <Grid Padding="16,16,16,14" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="128" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: badge, name, status, power -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="12" Background="#24FFFFFF">
                    <ContentPresenter x:Name="IconHost" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="#B8FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ToggleSwitch x:Name="Power" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                              VerticalAlignment="Center" Toggled="Power_Toggled" />
            </Grid>

            <!-- the device, edge to edge -->
            <ContentPresenter x:Name="ArtHost" Grid.Row="1" Margin="-16,2,-16,0" />

            <!-- its main control -->
            <ContentPresenter x:Name="BodyHost" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />

            <!-- footer -->
            <Grid Grid.Row="3" ColumnSpacing="8" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:WrapPanel x:Name="Chips" VerticalAlignment="Center" HorizontalSpacing="6" VerticalSpacing="6" />
                <HyperlinkButton x:Name="OpenButton" Grid.Column="1" Content="Open ›" Foreground="#A8DDFF" Padding="6,4"
                                 VerticalAlignment="Center" Click="Open_Click" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
