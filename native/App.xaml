<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HomeControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Thick sliders everywhere: a 12px track and a tall pill-shaped thumb with a short bar in it. -->
            <!-- (The track height is a theme resource the template only picks up from the window: see MainWindow.xaml.) -->
            <x:Double x:Key="SliderHorizontalHeight">40</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">32</x:Double>
            <x:Double x:Key="SliderVerticalThumbWidth">32</x:Double>
            <x:Double x:Key="SliderVerticalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">4</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">16</x:Double>

            <!-- Page layout -->
            <Thickness x:Key="PagePadding">32,16,32,40</Thickness>
            <x:Double x:Key="PageMaxWidth">1040</x:Double>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>

            <!-- Section titles on the redesigned pages ("Scenes", "Devices") -->
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- A button with no chrome, for clickable pictures and illustrated cards -->
            <Style x:Key="BareButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}"
                                              Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                              CornerRadius="{TemplateBinding CornerRadius}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Round translucent button on the dark device scenes (− and + on the dials) -->
            <Style x:Key="SceneRoundButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="BorderBrush" Value="#3DFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Small rounded label on the device scenes ("Warm white", "Home network") -->
            <Style x:Key="SceneChip" TargetType="Border">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Background" Value="#24FFFFFF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
