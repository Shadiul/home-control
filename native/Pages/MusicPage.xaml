<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LedControl.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="24">

                <!-- Title, what it does, and Start / Stop -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Music sync" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="The light reacts to what this PC plays. Stopping puts it back how it was." FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Height="36" Padding="18,0" VerticalAlignment="Center" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="StartIcon" Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="StartText" Text="Start" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="MusicError" Severity="Error" IsClosable="True" Title="Music sync" Visibility="Collapsed" />

                <!-- Now: the music's spectrum, and what the light is doing -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid x:Name="BarsGrid" Height="96" ColumnSpacing="4" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="ColourChip" Width="16" Height="16" StrokeThickness="1" VerticalAlignment="Center"
                                     Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <ProgressRing x:Name="MusicBusy" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="MusicStatus" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Style: four cards, one picked -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Style" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <c:AdaptiveGrid x:Name="StyleGrid" MinItemWidth="210" ColumnSpacing="6" RowSpacing="6" AutomationProperties.Name="Style" />
                </StackPanel>

                <!-- Options, in one grouped card -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Border Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <c:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                                <StackPanel Width="300" VerticalAlignment="Center">
                                    <TextBlock Text="Sensitivity" FontSize="14" />
                                    <TextBlock Text="Higher reacts to quieter sounds" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="SensSlider" Width="280" Minimum="0" Maximum="100" StepFrequency="1"
                                            ValueChanged="Sens_Changed" AutomationProperties.Name="Sensitivity" />
                                    <TextBlock x:Name="SensText" Width="32" TextAlignment="Right" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                </c:WrapPanel>
                            </Border>
                            <Border Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <c:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                                <StackPanel Width="300" VerticalAlignment="Center">
                                    <TextBlock Text="Listen to" FontSize="14" />
                                    <TextBlock Text="What's playing, or a microphone or line in" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="SourceBox" Width="324" SelectionChanged="Source_Changed" AutomationProperties.Name="Listen to" />
                                </c:WrapPanel>
                            </Border>
                            <Border Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <c:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                                <StackPanel Width="300" VerticalAlignment="Center">
                                    <TextBlock Text="Update speed" FontSize="14" />
                                    <TextBlock Text="Changes a second. Lower is gentler on the light" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="SpeedButtons" Orientation="Horizontal" AutomationProperties.Name="Update speed" />
                                </c:WrapPanel>
                            </Border>
                            <Border x:Name="PulseRow" Padding="16,12">
                                <c:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                                <StackPanel Width="300" VerticalAlignment="Center">
                                    <TextBlock Text="Pulse colour" FontSize="14" />
                                    <TextBlock Text="The colour the Pulse style breathes in" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid x:Name="PulseColours" Width="324" ColumnSpacing="6" AutomationProperties.Name="Pulse colour" />
                                </c:WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
