<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:art="using:LedControl.Art"
    xmlns:c="using:LedControl.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="24">

                <!-- Title, what it does, and Start (a violet pill) or Stop (a quiet outlined button) -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Music sync" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="The light reacts to what this PC plays. Stopping puts it back how it was." FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource BareButton}" Height="40" CornerRadius="20"
                            VerticalAlignment="Center" Click="Start_Click">
                        <Grid>
                            <Border x:Name="StartGlow" CornerRadius="26" Margin="-8,-4,-8,-12" IsHitTestVisible="False" />
                            <Border x:Name="StartFace" CornerRadius="20" Padding="20,0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="StartIcon" Width="24" Height="24" Stretch="None" />
                                    </Viewbox>
                                    <TextBlock x:Name="StartText" Text="Start" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <InfoBar x:Name="MusicError" Severity="Error" IsClosable="True" Title="Music sync" Visibility="Collapsed" />

                <!-- Stage beside the options on wide windows; the two stretch to the same height -->
                <Grid x:Name="Split" ColumnSpacing="16" RowSpacing="16" SizeChanged="Split_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Stage, kept minimal: one soft orb in the style's colour, a thin ring, play / stop, one line of text -->
                    <Grid x:Name="StageCard" CornerRadius="12" MinHeight="380" RequestedTheme="Dark">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="280" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="StageBase" Grid.RowSpan="2" />
                        <Border x:Name="StageGlow" Grid.RowSpan="2" />
                        <art:MusicStage x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Padding="22,0,22,18" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatusLine" FontSize="12" Foreground="#B8FFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="The light's colour now">
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse x:Name="LightGlow" Width="32" Height="32" Margin="-10" />
                                    <Ellipse x:Name="LightDot" />
                                </Grid>
                                <TextBlock Text="Light now" FontSize="12" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Options: lit by a soft wash of the style's colour -->
                    <Border x:Name="OptionsCard" Grid.Column="1" Style="{StaticResource Card}" Padding="0" CornerRadius="12">
                        <Grid>
                            <Border x:Name="Wash" CornerRadius="12" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Sensitivity: the whole 48px pill is the slider -->
                                <StackPanel x:Name="SensBox" Padding="18,18,18,0" Spacing="6">
                                    <TextBlock Text="Higher reacts to quieter sounds" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- The rest follows Windows 11 Settings: rows with a name, a grey description and a standard control -->
                                <StackPanel Grid.Row="2">
                                    <StackPanel Padding="18,14" Spacing="8" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Update speed" FontSize="14" />
                                            <TextBlock Text="Changes a second. Lower is gentler on the light" FontSize="12" LineHeight="16" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <!-- A segmented control -->
                                        <Border x:Name="SpeedBox" Padding="2" CornerRadius="6" BorderThickness="1">
                                            <c:AdaptiveGrid x:Name="SpeedButtons" MinItemWidth="1" MaxColumns="4" ColumnSpacing="2" RowSpacing="2"
                                                            AutomationProperties.Name="Update speed" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Padding="18,14" Spacing="8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Listen to" FontSize="14" />
                                            <TextBlock Text="What's playing, or a microphone or line in" FontSize="12" LineHeight="16" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectionChanged="Source_Changed" AutomationProperties.Name="Listen to" />
                                    </StackPanel>
                                    <StackPanel Padding="18,14,18,18" Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Pulse colour" FontSize="14" />
                                            <TextBlock x:Name="PulseDesc" FontSize="12" LineHeight="16" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <c:AdaptiveGrid x:Name="PulseColours" MinItemWidth="1" MaxColumns="8" ColumnSpacing="6" RowSpacing="6"
                                                        AutomationProperties.Name="Pulse colour" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Style: illustrated dark cards, each with soft animated art in the style's colours -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Style" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <c:AdaptiveGrid x:Name="StyleGrid" MinItemWidth="210" ColumnSpacing="10" RowSpacing="10" AutomationProperties.Name="Style" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
