<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.AcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Connection">
                <VisualState x:Name="StatusOk">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusBusy">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusError">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">

            <TextBlock Text="Air conditioners" Style="{StaticResource PageTitle}" />

            <InfoBar x:Name="SetupBar" Severity="Informational" Title="No air conditioners yet" IsClosable="False"
                     Message="Find the Gree air conditioners on your home network and pair with them.">
                <InfoBar.ActionButton>
                    <Button x:Name="FindButton" Content="Find air conditioners" Click="Find_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <SelectorBar x:Name="UnitBar" SelectionChanged="Unit_Changed" Margin="-4,0,0,8"
                         AutomationProperties.Name="Air conditioner" />

            <StackPanel x:Name="Controls" Spacing="4">
                <!-- The unit: mode badge (click to turn on or off), name, state, connection, power switch -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BareButton}" Click="Badge_Click" CornerRadius="40"
                                AutomationProperties.Name="Turn the air conditioner on or off">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Turn on or off" />
                            </ToolTipService.ToolTip>
                            <Grid Width="80" Height="80">
                                <Border x:Name="BadgeOff" CornerRadius="40"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                <Border x:Name="Badge" CornerRadius="40" Opacity="0">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="BadgeBrush" Color="#2D7FF9" />
                                    </Border.Background>
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.25" />
                                    </Border.OpacityTransition>
                                </Border>
                                <Viewbox x:Name="BadgeIcon" Width="30" Height="30" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="NameText" Text="Air conditioner" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button x:Name="RenameButton" Background="Transparent" BorderThickness="0" Padding="6"
                                        VerticalAlignment="Center" AutomationProperties.Name="Rename">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Rename" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout x:Name="RenameFlyout" Opening="RenameFlyout_Opening">
                                            <StackPanel Spacing="12" Width="260">
                                                <TextBox x:Name="RenameBox" Header="Name" PlaceholderText="For example, Bedroom"
                                                         KeyDown="RenameBox_KeyDown" />
                                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                                                        HorizontalAlignment="Right" MinWidth="96" Click="RenameSave_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="StateText" Text="…" Style="{StaticResource BodyTextBlockStyle}" />
                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Connecting…" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <ToggleSwitch x:Name="PowerSwitch" Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                      OnContent="On" OffContent="Off" Toggled="Power_Toggled"
                                      AutomationProperties.Name="Power" />
                    </Grid>
                </Border>

                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Can't reach the air conditioner" IsClosable="True" Margin="0,4,0,0">
                    <InfoBar.ActionButton>
                        <Button Content="Try again" Click="Retry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Temperature -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,4,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="2,0,0,0">
                            <FontIcon Glyph="&#xE9CA;" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Temperature" />
                                <TextBlock x:Name="RoomText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="MinusButton" Width="44" Height="44" CornerRadius="22" Padding="0" Click="Minus_Click"
                                    AutomationProperties.Name="Lower temperature">
                                <FontIcon Glyph="&#xE738;" FontSize="16" />
                            </Button>
                            <TextBlock x:Name="TempText" Text="24 °C" Style="{StaticResource TitleTextBlockStyle}"
                                       MinWidth="96" TextAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.Name="Target temperature" />
                            <Button x:Name="PlusButton" Width="44" Height="44" CornerRadius="22" Padding="0" Click="Plus_Click"
                                    AutomationProperties.Name="Raise temperature">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
                <SelectorBar x:Name="ModeBar" SelectionChanged="Mode_Changed" Margin="-4,0,0,4"
                             AutomationProperties.Name="Mode" />

                <TextBlock Text="Fan and airflow" Style="{StaticResource SectionHeader}" />
                <tk:SettingsCard Header="Fan speed">
                    <tk:SettingsCard.HeaderIcon>
                        <PathIcon Data="M8,8 C6.08,5.28 5.92,1.76 8.48,1.28 C11.04,0.8 11.52,4.32 8,8 Z M8,8 C11.32,7.7 14.44,9.32 13.58,11.78 C12.72,14.23 9.43,12.89 8,8 Z M8,8 C6.6,11.02 3.64,12.92 1.94,10.94 C0.24,8.97 3.05,6.79 8,8 Z M6.8,8 A1.2,1.2 0 1 0 9.2,8 A1.2,1.2 0 1 0 6.8,8 Z" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="FanBox" MinWidth="200" SelectionChanged="Fan_Changed" AutomationProperties.Name="Fan speed" />
                </tk:SettingsCard>
                <!-- Airflow: pick where the air goes (pictures of the direction), or swing -->
                <tk:SettingsCard x:Name="VCard" Header="Up and down" Description="…">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel x:Name="VPositions" Orientation="Horizontal" Spacing="4" />
                        <Border Width="1" Margin="0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleButton x:Name="VSwingButton" Click="Swing_Click" Height="40" Padding="12,0"
                                      AutomationProperties.Name="Swing up and down">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Sweep the air up and down" />
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ContentPresenter x:Name="VSwingIcon" VerticalAlignment="Center" />
                                <TextBlock Text="Swing" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="HCard" Header="Left and right" Description="…">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel x:Name="HPositions" Orientation="Horizontal" Spacing="4" />
                        <Border Width="1" Margin="0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleButton x:Name="HSwingButton" Click="Swing_Click" Height="40" Padding="12,0"
                                      AutomationProperties.Name="Swing left and right">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Sweep the air left and right" />
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ContentPresenter x:Name="HSwingIcon" VerticalAlignment="Center" />
                                <TextBlock Text="Swing" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </tk:SettingsCard>

                <TextBlock Text="Extras" Style="{StaticResource SectionHeader}" />
                <tk:SettingsCard x:Name="TurboCard" Header="Turbo" Description="Full power to reach the temperature quickly. Cool and Heat only.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="TurboSwitch" Tag="Tur" Toggled="Extra_Toggled" AutomationProperties.Name="Turbo" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Quiet" Description="Lower fan noise">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74F;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="QuietSwitch" Tag="Quiet" Toggled="Extra_Toggled" AutomationProperties.Name="Quiet" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Sleep" Description="Eases the temperature up or down slowly overnight">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE708;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="SleepSwitch" Tag="SwhSlp" Toggled="Extra_Toggled" AutomationProperties.Name="Sleep" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Display light" Description="The temperature display on the indoor unit">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LightSwitch" Tag="Lig" Toggled="Extra_Toggled" AutomationProperties.Name="Display light" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Health" Description="Ionizer, on units that have one">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC0A;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="HealthSwitch" Tag="Health" Toggled="Extra_Toggled" AutomationProperties.Name="Health" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="X-Fan" Description="Keeps the fan running briefly after turning off, to dry the coil and prevent mould">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEB42;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="XFanSwitch" Tag="Blo" Toggled="Extra_Toggled" AutomationProperties.Name="X-Fan" />
                </tk:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
