<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.AcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LedControl.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="20">

                <!-- Title, a tab per unit, and Rename -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Climate" Style="{StaticResource TitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-4,0,0,0">
                        <SelectorBar x:Name="UnitBar" SelectionChanged="Unit_Changed" AutomationProperties.Name="Air conditioner" />
                        <Button x:Name="RenameButton" Background="Transparent" BorderThickness="0" Padding="10,6" VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="Rename" FontSize="13" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="RenameFlyout" Opening="RenameFlyout_Opening">
                                    <StackPanel Spacing="12" Width="260">
                                        <TextBox x:Name="RenameBox" Header="Name" PlaceholderText="For example, Bedroom" KeyDown="RenameBox_KeyDown" />
                                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" MinWidth="96"
                                                Click="RenameSave_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <InfoBar x:Name="SetupBar" Severity="Informational" Title="No air conditioners yet" IsClosable="False"
                         Message="Find the Gree air conditioners on your home network and pair with them.">
                    <InfoBar.ActionButton>
                        <Button x:Name="FindButton" Content="Find air conditioners" Click="Find_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Can't reach the air conditioner" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Content="Try again" Click="Retry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel x:Name="Controls" Spacing="24">
                    <!-- Temperature beside Mode on wide windows; Mode moves below on narrow ones -->
                    <c:AdaptiveGrid MinItemWidth="360" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                        <Border Style="{StaticResource Card}" Padding="24,20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="DialHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Padding="0,14,0,0" BorderThickness="0,1,0,0" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Room" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                        <TextBlock x:Name="RoomText" Text="--" FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Power" FontSize="14" />
                                            <TextBlock x:Name="StateText" Text="…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="PowerSwitch" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                                                      Toggled="Power_Toggled" AutomationProperties.Name="Power" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <!-- Auto across the top, the other four in two columns -->
                            <Grid x:Name="ModeGrid" Grid.Row="1" ColumnSpacing="10" RowSpacing="10" AutomationProperties.Name="Mode">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="84" />
                                    <RowDefinition Height="*" MinHeight="84" />
                                    <RowDefinition Height="*" MinHeight="84" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </c:AdaptiveGrid>

                    <!-- Fan speed, up and down, left and right: a picture with its own arc slider each -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Fan and airflow" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:AdaptiveGrid x:Name="FlowGrid" MinItemWidth="300" ColumnSpacing="12" RowSpacing="12" />
                    </StackPanel>

                    <!-- More options: Windows Settings cards, two columns when there's room -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="More options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:AdaptiveGrid x:Name="ExtrasGrid" MinItemWidth="420" MaxColumns="2" ColumnSpacing="4" RowSpacing="4" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
