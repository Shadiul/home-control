<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.LightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:LedControl.Pages"
    xmlns:app="using:LedControl"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Connection">
                <VisualState x:Name="StatusOk">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusBusy">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusError">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusSetup">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">

            <TextBlock Text="Light" Style="{StaticResource PageTitle}" />

            <!-- The light: preview (click to toggle), name, state, connection, power switch -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewButton" Style="{StaticResource BareButton}" Click="Preview_Click"
                            CornerRadius="64" AutomationProperties.Name="Turn the light on or off">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Turn on or off" />
                        </ToolTipService.ToolTip>
                        <Grid Width="128" Height="128">
                            <Border CornerRadius="64">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowInner" Offset="0.3" Color="#00FFFFFF" />
                                        <GradientStop x:Name="GlowOuter" Offset="1.0" Color="#00FFFFFF" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="BulbOff" Width="72" Height="72" CornerRadius="36"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Border x:Name="Bulb" Width="72" Height="72" CornerRadius="36" Opacity="0">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BulbBrush" Color="White" />
                                </Border.Background>
                                <Border.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.25" />
                                </Border.OpacityTransition>
                            </Border>
                            <FontIcon x:Name="BulbIcon" Glyph="&#xEA80;" FontSize="28" />
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="DeviceName" Text="Light" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StateText" Text="…" Style="{StaticResource BodyTextBlockStyle}" />
                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Connecting…" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <ToggleSwitch x:Name="PowerSwitch" Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  OnContent="On" OffContent="Off" Toggled="Power_Toggled"
                                  AutomationProperties.Name="Power" />
                </Grid>
            </Border>

            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Can't reach the light" IsClosable="True" Margin="0,4,0,0">
                <InfoBar.ActionButton>
                    <Button Content="Try again" Click="Retry_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="SetupBar" Severity="Informational" Title="Connect your light"
                     Message="Add the light's local key or your Tuya Cloud details in Settings." IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Open Settings" Click="OpenSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
            <SelectorBar x:Name="ModeBar" SelectionChanged="Mode_Changed" Margin="-4,0,0,4">
                <SelectorBarItem x:Name="WhiteItem" Text="White">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ColourItem" Text="Colour">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- White -->
            <StackPanel x:Name="WhitePanel" Spacing="4">
                <tk:SettingsCard Header="Brightness">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Slider x:Name="BrightnessSlider" Width="260" Minimum="1" Maximum="100" StepFrequency="1"
                            ValueChanged="White_Changed" AutomationProperties.Name="Brightness" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="TempCard" Header="Warmth" Description="From warm to cool white">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9CA;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Slider x:Name="TempSlider" Width="260" Minimum="0" Maximum="100" StepFrequency="1"
                            ValueChanged="White_Changed" AutomationProperties.Name="Warmth" />
                </tk:SettingsCard>
            </StackPanel>

            <!-- Colour -->
            <StackPanel x:Name="ColourPanel" Spacing="4" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="2,0,0,0">
                            <FontIcon Glyph="&#xE790;" FontSize="16" />
                            <TextBlock Text="Colour" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Custom colour…">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" Opening="PickerFlyout_Opening">
                                    <ColorPicker x:Name="Picker" ColorSpectrumShape="Box" IsAlphaEnabled="False" IsColorSliderVisible="False"
                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True" ColorChanged="Picker_ColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <GridView x:Name="Swatches" Grid.Row="1" Grid.ColumnSpan="2" SelectionMode="Single"
                                  IsItemClickEnabled="True" ItemClick="Swatch_Click" Margin="-4,0,0,0"
                                  AutomationProperties.Name="Colours">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:Swatch">
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{x:Bind Brush}"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
                <tk:SettingsCard Header="Brightness">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Slider x:Name="ColourBrightness" Width="260" Minimum="1" Maximum="100" StepFrequency="1"
                            ValueChanged="ColourBrightness_Changed" AutomationProperties.Name="Colour brightness" />
                </tk:SettingsCard>
            </StackPanel>

            <TextBlock Text="Scenes" Style="{StaticResource SectionHeader}" />
            <GridView x:Name="SceneGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Scene_Click"
                      Margin="-4,0,0,0" AutomationProperties.Name="Scenes">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="app:Scene">
                        <Grid Width="148" Height="92" Padding="14,12" RowSpacing="8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                              CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
