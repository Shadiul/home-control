<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.LightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LedControl.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="24">

                <!-- Title with the light's name and connection; power on the right -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Light" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="PowerText" FontSize="14" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="PowerSwitch" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                                      Toggled="Power_Toggled" AutomationProperties.Name="Light power" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Can't reach the light" IsClosable="True" Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button Content="Try again" Click="Retry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="SetupBar" Severity="Informational" Title="Connect your light" IsClosable="False" Visibility="Collapsed"
                         Message="Add your light's details in Settings to control it from this PC.">
                    <InfoBar.ActionButton>
                        <Button Content="Open Settings" Click="OpenSettings_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Preview beside the controls on wide windows -->
                <c:AdaptiveGrid MinItemWidth="340" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="14">
                            <Button x:Name="PreviewButton" Style="{StaticResource BareButton}" Click="Preview_Click" Height="260"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    CornerRadius="6" AutomationProperties.Name="Turn the light on or off">
                                <Grid x:Name="Stage" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Border x:Name="StageGlow" />
                                    <Viewbox x:Name="BulbBox" Width="160" Height="236" />
                                </Grid>
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Click the preview to turn the light on or off" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Controls: one grouped card, like Windows Settings -->
                    <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Padding="16,14" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mode" FontSize="14" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Mode">
                                    <ToggleButton x:Name="WhiteButton" Content="White" Height="32" Padding="16,0" CornerRadius="4,0,0,4"
                                                  Click="White_Click" />
                                    <ToggleButton x:Name="ColourButton" Content="Colour" Height="32" Padding="16,0" CornerRadius="0,4,4,0"
                                                  Margin="-1,0,0,0" Click="Colour_Click" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid>
                                    <TextBlock Text="Brightness" FontSize="14" />
                                    <TextBlock x:Name="BrightnessText" FontSize="14" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="100" StepFrequency="1"
                                        ValueChanged="Brightness_Changed" AutomationProperties.Name="Brightness" />
                            </StackPanel>

                            <StackPanel x:Name="WhitePanel" Padding="16,12">
                                <Grid>
                                    <TextBlock Text="Warmth" FontSize="14" />
                                    <TextBlock x:Name="WarmthText" FontSize="14" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="TempSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="Temp_Changed" AutomationProperties.Name="Warmth, from warm to cool white" />
                                <Grid>
                                    <TextBlock Text="Warm" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Cool" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ColourPanel" Padding="16,12,16,16" Spacing="10" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="Colour" FontSize="14" VerticalAlignment="Center" />
                                    <Button Content="Custom…" HorizontalAlignment="Right" Height="32">
                                        <Button.Flyout>
                                            <Flyout Opening="PickerFlyout_Opening">
                                                <ColorPicker x:Name="Picker" ColorSpectrumShape="Box" IsAlphaEnabled="False" IsColorSliderVisible="False"
                                                             IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                                             ColorChanged="Picker_ColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <c:AdaptiveGrid x:Name="SwatchGrid" MinItemWidth="40" ColumnSpacing="6" RowSpacing="6" AutomationProperties.Name="Colours" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>

                <!-- Scenes: each card shows a room lit the way the scene lights it -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Scenes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <c:AdaptiveGrid x:Name="SceneGrid" MinItemWidth="150" ColumnSpacing="10" RowSpacing="10" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
