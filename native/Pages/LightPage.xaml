<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.LightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LedControl.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="24">

                <!-- Title with the light's name and connection; power on the right -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Light" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="PowerText" FontSize="14" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="PowerSwitch" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                                      Toggled="Power_Toggled" AutomationProperties.Name="Light power" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Can't reach the light" IsClosable="True" Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button Content="Try again" Click="Retry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="SetupBar" Severity="Informational" Title="Connect your light" IsClosable="False" Visibility="Collapsed"
                         Message="Add your light's details in Settings to control it from this PC.">
                    <InfoBar.ActionButton>
                        <Button Content="Open Settings" Click="OpenSettings_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Preview beside the controls on wide windows; the two cards stretch to the same height -->
                <Grid x:Name="Split" ColumnSpacing="16" RowSpacing="16" SizeChanged="Split_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="16">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- The stage grows to fill the card -->
                            <Button x:Name="PreviewButton" Style="{StaticResource BareButton}" Click="Preview_Click" MinHeight="260"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" CornerRadius="6" AutomationProperties.Name="Turn the light on or off">
                                <Grid x:Name="Stage" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Border x:Name="StageGlow" />
                                    <Viewbox x:Name="BulbBox" Width="160" Height="236" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Click the preview to turn the light on or off" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Controls: lit by a soft wash of the light's own colour, with mode tiles, thick sliders and round
                         swatches. The blocks spread out to fill the card, so it is always as tall as the preview. -->
                    <Border x:Name="ControlsCard" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Border x:Name="Wash" CornerRadius="8" IsHitTestVisible="False" />
                            <Grid Padding="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="20" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="20" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Mode: two tiles -->
                                <Grid x:Name="ModeTiles" ColumnSpacing="8" AutomationProperties.Name="Mode">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- Brightness: a thick track that fills in the light's colour, dim and bright suns at its ends -->
                                <StackPanel Grid.Row="2" Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Brightness" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border x:Name="BrightnessPill" HorizontalAlignment="Right" MinWidth="44" Padding="8,3" CornerRadius="10">
                                            <TextBlock x:Name="BrightnessText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="BrightnessRow" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </StackPanel>

                                <!-- White: warmth on a warm-to-cool track, and one-tap presets -->
                                <StackPanel x:Name="WhitePanel" Grid.Row="4" Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Warmth" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border x:Name="WarmthPill" HorizontalAlignment="Right" Padding="10,3" CornerRadius="10">
                                            <TextBlock x:Name="WarmthText" FontSize="13" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <ContentPresenter x:Name="WarmthHost" />
                                    <c:AdaptiveGrid x:Name="WhiteGrid" MinItemWidth="1" MaxColumns="5" ColumnSpacing="6" RowSpacing="6" Margin="0,4,0,0"
                                                    AutomationProperties.Name="White presets" />
                                </StackPanel>

                                <!-- Colour: the shared swatch tiles in seven columns, and Custom -->
                                <StackPanel x:Name="ColourPanel" Grid.Row="4" Spacing="12" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock Text="Colour" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border x:Name="ColourPill" HorizontalAlignment="Right" Padding="10,3" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse x:Name="ColourDot" Width="10" Height="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ColourNameText" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <c:AdaptiveGrid x:Name="SwatchGrid" MinItemWidth="1" MaxColumns="7" ColumnSpacing="6" RowSpacing="6" AutomationProperties.Name="Colours" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Scenes: each card shows a room lit the way the scene lights it -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Scenes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <c:AdaptiveGrid x:Name="SceneGrid" MinItemWidth="150" ColumnSpacing="10" RowSpacing="10" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
