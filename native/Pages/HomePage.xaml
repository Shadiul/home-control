<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:art="using:HomeControl.Art"
    xmlns:c="using:HomeControl.Controls">
    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="28">

                <!-- Banner: the sky over the house, with the live state of each device drawn into it -->
                <Grid x:Name="Hero" CornerRadius="16" MinHeight="196" SizeChanged="Hero_SizeChanged">
                    <Grid.Background>
                        <LinearGradientBrush x:Name="HeroBrush" StartPoint="0,0.1" EndPoint="1,0.9">
                            <GradientStop Offset="0" Color="#142A52" />
                            <GradientStop Offset="0.52" Color="#27508F" />
                            <GradientStop Offset="1" Color="#C9825A" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,250,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#59FFD696" />
                                <GradientStop Offset="0.7" Color="#00FFD696" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid Padding="30,28" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="10">
                            <TextBlock x:Name="DateText" FontSize="13" Foreground="#D9FFFFFF" />
                            <TextBlock x:Name="GreetingText" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap" />
                            <c:WrapPanel x:Name="HeroChips" Margin="0,6,0,0" HorizontalSpacing="8" VerticalSpacing="8" />
                        </StackPanel>
                        <art:HouseArt x:Name="House" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Scenes: illustrated cards that set the light and the air conditioners together -->
                <StackPanel Spacing="10">
                    <c:WrapPanel HorizontalSpacing="12" VerticalSpacing="2">
                        <TextBlock Text="Scenes" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="SceneHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </c:WrapPanel>
                    <c:AdaptiveGrid x:Name="SceneGrid" MinItemWidth="200" ColumnSpacing="12" RowSpacing="12" />
                </StackPanel>

                <!-- Devices: each card is a scene of its own, built around a thick radial control -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Devices" Style="{StaticResource SectionTitle}" />
                    <c:AdaptiveGrid x:Name="DeviceGrid" MinItemWidth="300" ColumnSpacing="14" RowSpacing="14" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
