<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="24">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <InfoBar x:Name="Notice" IsClosable="True" Visibility="Collapsed" />

                <!-- Devices: one row per device with how it's connected; open a row for its details -->
                <StackPanel Spacing="4">
                    <Grid Margin="0,0,0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" />
                            <Button x:Name="CheckButton" Content="Check connections" Click="Check_Click"
                                    ToolTipService.ToolTip="Tests each way of reaching the light, and fixes its address if it moved" />
                            <Button x:Name="FindAcButton" Content="Find devices" Style="{StaticResource AccentButtonStyle}" Click="FindAc_Click"
                                    ToolTipService.ToolTip="Looks for Gree air conditioners on your home network, pairs with new ones and updates addresses that changed" />
                        </StackPanel>
                    </Grid>

                    <tk:SettingsExpander x:Name="DeviceExpander" Header="Light" Description="…">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEA80;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="LightDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="LightStatus" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Header="Device ID">
                                <TextBox x:Name="DeviceId" Width="300" AutomationProperties.Name="Device ID" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="IP address" Description="The light's address on your home network">
                                <TextBox x:Name="DeviceIp" Width="300" AutomationProperties.Name="IP address" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Protocol version">
                                <ComboBox x:Name="DeviceVersion" Width="300" AutomationProperties.Name="Protocol version">
                                    <x:String>3.5</x:String>
                                    <x:String>3.4</x:String>
                                    <x:String>3.3</x:String>
                                </ComboBox>
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Local key" Description="Needed for home network control and music sync">
                                <PasswordBox x:Name="DeviceKey" Width="300" AutomationProperties.Name="Local key" />
                            </tk:SettingsCard>
                            <tk:SettingsCard>
                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="SaveDevice_Click" />
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>

                    <!-- One expander per air conditioner, built in code -->
                    <StackPanel x:Name="AcList" Spacing="4" />
                    <tk:SettingsCard x:Name="NoAcCard" Header="No air conditioners yet"
                                     Description="Use Find devices to look for Gree units on your home network.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                </StackPanel>

                <!-- Connection -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Connection" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <tk:SettingsCard Header="How the app reaches the light" Description="Automatic uses the home network and falls back to Tuya Cloud">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE701;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ConnBox" MinWidth="200" SelectionChanged="Conn_Changed" AutomationProperties.Name="How the app reaches the light">
                            <ComboBoxItem Content="Automatic" Tag="auto" />
                            <ComboBoxItem Content="Home network only" Tag="local" />
                            <ComboBoxItem Content="Tuya Cloud only" Tag="cloud" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsExpander x:Name="CloudExpander" Header="Tuya Cloud account" Description="…">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE753;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Header="Data centre" Description="Where your Smart Life account lives">
                                <ComboBox x:Name="CloudRegion" Width="300" AutomationProperties.Name="Data centre" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Access ID" Description="From your project at iot.tuya.com">
                                <TextBox x:Name="CloudKey" Width="300" AutomationProperties.Name="Access ID" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Access Secret">
                                <PasswordBox x:Name="CloudSecret" Width="300" AutomationProperties.Name="Access Secret" />
                            </tk:SettingsCard>
                            <tk:SettingsCard>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="CloudBusy" Width="18" Height="18" IsActive="False" />
                                    <Button Content="Save" Click="SaveCloud_Click" MinWidth="100" />
                                    <Button Content="Save and get local key" Style="{StaticResource AccentButtonStyle}" Click="FetchKey_Click" />
                                </StackPanel>
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                </StackPanel>

                <!-- App -->
                <StackPanel Spacing="4">
                    <TextBlock Text="App" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <tk:SettingsCard Header="App theme" Description="Follows Windows unless you pick one">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="Theme_Changed" AutomationProperties.Name="App theme">
                            <ComboBoxItem Content="Use system setting" Tag="auto" />
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Keep running next to the clock" Description="Closing the window keeps the quick panel available">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TrayToggle" Toggled="Tray_Toggled" AutomationProperties.Name="Keep running next to the clock" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Start with Windows" Description="Starts quietly next to the clock when you sign in">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartupToggle" Toggled="Startup_Toggled" AutomationProperties.Name="Start with Windows" />
                    </tk:SettingsCard>
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <tk:SettingsExpander x:Name="AboutExpander" Header="Home Control">
                        <tk:SettingsExpander.HeaderIcon>
                            <BitmapIcon UriSource="ms-appx:///Assets/icon.png" ShowAsMonochrome="False" />
                        </tk:SettingsExpander.HeaderIcon>
                        <Button Content="Open settings folder" Click="OpenConfig_Click" />
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard x:Name="ConfigCard" Header="Settings file" />
                            <tk:SettingsCard Header="Built with" Description="WinUI 3 and the Windows App SDK (.NET 10). Light protocol: Tuya local 3.5, ported from TinyTuya. Air conditioners: Gree local protocol." />
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
