<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LedControl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <InfoBar x:Name="Notice" IsClosable="True" Margin="0,0,0,8" />

            <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" Margin="1,0,0,6" />
            <tk:SettingsCard Header="Connection" Description="How the app reaches your light">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE701;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ConnBox" MinWidth="240" SelectionChanged="Conn_Changed" AutomationProperties.Name="Connection">
                    <ComboBoxItem Content="Automatic" Tag="auto" />
                    <ComboBoxItem Content="Home network only" Tag="local" />
                    <ComboBoxItem Content="Tuya Cloud only" Tag="cloud" />
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Check connection" Description="Tests each way of reaching the light">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="CheckBusy" Width="18" Height="18" IsActive="False" />
                    <Button x:Name="CheckButton" Content="Run check" Click="Check_Click" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="Light" Style="{StaticResource SectionHeader}" />
            <tk:SettingsExpander x:Name="DeviceExpander" Header="Light details" Description="…">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEA80;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Device ID">
                        <TextBox x:Name="DeviceId" Width="300" AutomationProperties.Name="Device ID" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="IP address" Description="The light's address on your home network">
                        <TextBox x:Name="DeviceIp" Width="300" AutomationProperties.Name="IP address" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Protocol version">
                        <ComboBox x:Name="DeviceVersion" Width="300" AutomationProperties.Name="Protocol version">
                            <x:String>3.5</x:String>
                            <x:String>3.4</x:String>
                            <x:String>3.3</x:String>
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Local key" Description="Needed for home network control and music sync">
                        <PasswordBox x:Name="DeviceKey" Width="300" AutomationProperties.Name="Local key" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="SaveDevice_Click" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander x:Name="CloudExpander" Header="Tuya Cloud"
                                 Description="Backup when the home network fails, and gets the light's local key">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE753;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Data centre" Description="Where your Smart Life account lives">
                        <ComboBox x:Name="CloudRegion" Width="300" AutomationProperties.Name="Data centre" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Access ID" Description="From your project at iot.tuya.com">
                        <TextBox x:Name="CloudKey" Width="300" AutomationProperties.Name="Access ID" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Access Secret">
                        <PasswordBox x:Name="CloudSecret" Width="300" AutomationProperties.Name="Access Secret" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CloudBusy" Width="18" Height="18" IsActive="False" />
                            <Button Content="Save" Click="SaveCloud_Click" MinWidth="100" />
                            <Button Content="Save and get local key" Style="{StaticResource AccentButtonStyle}" Click="FetchKey_Click" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="Air conditioners" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="Find air conditioners"
                             Description="Looks for Gree units on your home network and pairs with them. Also updates addresses that changed.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE721;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="FindBusy" Width="18" Height="18" IsActive="False" />
                    <Button x:Name="FindAcButton" Content="Find" MinWidth="100" Click="FindAc_Click" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsExpander x:Name="AcExpander" Header="Paired air conditioners" Description="…">
                <tk:SettingsExpander.HeaderIcon>
                    <PathIcon Data="F1 M8.62,8 L8.62,0.8 L7.38,0.8 L7.38,8 Z M8.4,3.22 L6.41,1.55 L5.61,2.51 L7.6,4.18 Z M8.4,4.18 L10.39,2.51 L9.59,1.55 L7.6,3.22 Z M8.31,8.54 L14.55,4.94 L13.92,3.86 L7.69,7.46 Z M12.34,5.96 L12.79,3.4 L11.56,3.18 L11.11,5.74 Z M11.51,6.44 L13.95,7.33 L14.38,6.15 L11.94,5.26 Z M7.69,8.54 L13.92,12.14 L14.55,11.06 L8.31,7.46 Z M11.94,10.74 L14.38,9.85 L13.95,8.67 L11.51,9.56 Z M11.11,10.26 L11.56,12.82 L12.79,12.6 L12.34,10.04 Z M7.38,8 L7.38,15.2 L8.62,15.2 L8.62,8 Z M7.6,12.78 L9.59,14.45 L10.39,13.49 L8.4,11.82 Z M7.6,11.82 L5.61,13.49 L6.41,14.45 L8.4,12.78 Z M7.69,7.46 L1.45,11.06 L2.08,12.14 L8.31,8.54 Z M3.66,10.04 L3.21,12.6 L4.44,12.82 L4.89,10.26 Z M4.49,9.56 L2.05,8.67 L1.62,9.85 L4.06,10.74 Z M8.31,7.46 L2.08,3.86 L1.45,4.94 L7.69,8.54 Z M4.06,5.26 L1.62,6.15 L2.05,7.33 L4.49,6.44 Z M4.89,5.74 L4.44,3.18 L3.21,3.4 L3.66,5.96 Z" />
                </tk:SettingsExpander.HeaderIcon>
            </tk:SettingsExpander>

            <TextBlock Text="App" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="App theme" Description="Light, dark, or follow Windows">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="Theme_Changed" AutomationProperties.Name="App theme">
                    <ComboBoxItem Content="Use system setting" Tag="auto" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Dark" Tag="dark" />
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Keep running in the notification area"
                             Description="Closing the window leaves Home Control running next to the clock">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="TrayToggle" Toggled="Tray_Toggled" AutomationProperties.Name="Keep running in the notification area" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Start with Windows" Description="Starts in the notification area when you sign in">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupToggle" Toggled="Startup_Toggled" AutomationProperties.Name="Start with Windows" />
            </tk:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
            <tk:SettingsExpander x:Name="AboutExpander" Header="Home Control">
                <tk:SettingsExpander.HeaderIcon>
                    <BitmapIcon UriSource="ms-appx:///Assets/icon.png" ShowAsMonochrome="False" />
                </tk:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Name="ConfigCard" Header="Settings file">
                        <Button Content="Open folder" Click="OpenConfig_Click" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Built with" Description="WinUI 3 and the Windows App SDK (.NET 10). Light protocol: Tuya local 3.5, ported from TinyTuya. Air conditioners: Gree local protocol." />
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
