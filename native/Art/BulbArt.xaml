<?xml version="1.0" encoding="utf-8"?>
<!-- A realistic light bulb that glows in the light's colour and brightness. Drawn on a 300 × 128 canvas. -->
<UserControl
    x:Class="LedControl.Art.BulbArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="BulbMetal" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#7E7E80" />
            <GradientStop Offset="0.35" Color="#E9E9EA" />
            <GradientStop Offset="1" Color="#6E6E70" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="300" Height="128">
            <!-- halo -->
            <Ellipse x:Name="Halo" Canvas.Left="90" Canvas.Top="-8" Width="120" Height="120">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="HaloInner" Offset="0" Color="#B3FFC47E" />
                        <GradientStop x:Name="HaloOuter" Offset="1" Color="#00FFC47E" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas>
                <Canvas.RenderTransform>
                    <CompositeTransform TranslateX="118" TranslateY="6" ScaleX="0.53" ScaleY="0.53" />
                </Canvas.RenderTransform>
                <!-- glass -->
                <Path Data="M60 6C30.5 6 12 28.5 12 55c0 19 10.5 31 20.5 42.5C38.5 104.5 41 111 41 120h38c0-9 2.5-15.5 8.5-22.5C97.5 86 108 74 108 55 108 28.5 89.5 6 60 6z"
                      x:Name="Glass" StrokeThickness="1.5" Stroke="#FFD9A8">
                    <Path.Fill>
                        <RadialGradientBrush Center="0.42,0.36" GradientOrigin="0.42,0.36" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop x:Name="Glass2" Offset="0.5" Color="#FFE1BC" />
                            <GradientStop x:Name="Glass3" Offset="1" Color="#FFC47E" />
                        </RadialGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- filament and its supports -->
                <Path Data="M53 120V88M67 120V88" Stroke="#CDBE9E" StrokeThickness="1.4" />
                <Path x:Name="Filament" Data="M53 88c0-14-7-22-4-34M67 88c0-14 7-22 4-34M49 54c3.5-6 18.5-6 22 0"
                      Stroke="#FFE9C4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <!-- highlight on the glass -->
                <Ellipse Canvas.Left="30" Canvas.Top="21" Width="16" Height="34" Fill="#8CFFFFFF" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-28" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <!-- cap and screw base -->
                <Rectangle Canvas.Left="39.5" Canvas.Top="118" Width="41" Height="9" RadiusX="2.5" RadiusY="2.5" Fill="#F2F2F2" />
                <Rectangle Canvas.Left="41" Canvas.Top="128" Width="38" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource BulbMetal}" />
                <Rectangle Canvas.Left="41.5" Canvas.Top="137" Width="37" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource BulbMetal}" />
                <Rectangle Canvas.Left="42" Canvas.Top="146" Width="36" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource BulbMetal}" />
                <Path Data="M44 155h32l-4 8.5c-.6 1.3-1.9 2-3.3 2H51.3c-1.4 0-2.7-.7-3.3-2z" Fill="#4A4A4C" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
