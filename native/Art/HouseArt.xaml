<?xml version="1.0" encoding="utf-8"?>
<!-- The house in the Home banner: the window glows with the light, and the AC on the wall blows air while
     any unit runs. A moon at night, a sun by day. Drawn on a 240 × 150 canvas. -->
<UserControl
    x:Class="HomeControl.Art.HouseArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas Width="240" Height="150">
        <Path x:Name="Moon" Data="M196 26a14 14 0 1 0 14 18a11 11 0 1 1-14-18z" Fill="#E6FFE7B8" />
        <Path x:Name="Stars" Data="M150 20l1.5 3 3 1.5-3 1.5-1.5 3-1.5-3-3-1.5 3-1.5z M226 66l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" Fill="#CCFFFFFF" />
        <Grid x:Name="Sun" Canvas.Left="176" Canvas.Top="12" Width="48" Height="48" Visibility="Collapsed">
            <Ellipse>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#99FFE7A8" />
                        <GradientStop Offset="1" Color="#00FFE7A8" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="22" Height="22" Fill="#FFF1C4" />
        </Grid>
        <!-- light from the window -->
        <Ellipse x:Name="Glow" Canvas.Left="18" Canvas.Top="52" Width="140" Height="88">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowInner" Offset="0" Color="#00FFC47E" />
                    <GradientStop x:Name="GlowOuter" Offset="1" Color="#00FFC47E" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Path Data="M20 146h200" Stroke="#59FFFFFF" StrokeThickness="2" />
        <!-- roof, walls, window, door -->
        <Path Data="M30 72 L95 26 L160 72 Z" Fill="#D90E1F3D" />
        <Rectangle Canvas.Left="40" Canvas.Top="70" Width="110" Height="76" Fill="#EB14274A" />
        <Rectangle x:Name="Window" Canvas.Left="56" Canvas.Top="86" Width="40" Height="30" RadiusX="3" RadiusY="3" Fill="#22375E" />
        <Path Data="M76 86v30M56 101h40" Stroke="#14274A" StrokeThickness="2" />
        <Rectangle Canvas.Left="112" Canvas.Top="104" Width="22" Height="42" RadiusX="2" RadiusY="2" Fill="#0B1830" />
        <!-- the AC on the wall -->
        <Rectangle Canvas.Left="104" Canvas.Top="80" Width="38" Height="11" RadiusX="5" RadiusY="5" Fill="#E8ECF0" />
        <Path x:Name="AcAir" Data="M110 95v8M118 95v10M126 95v10M134 95v8" Stroke="#9BD3FF" StrokeThickness="2"
              StrokeDashArray="1,1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
    </Canvas>
</UserControl>
