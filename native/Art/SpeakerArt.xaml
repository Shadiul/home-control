<?xml version="1.0" encoding="utf-8"?>
<!-- A speaker cabinet with sound waves either side while music sync runs. Drawn on a 300 × 128 canvas. -->
<UserControl
    x:Class="HomeControl.Art.SpeakerArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="Cone" Center="0.45,0.4" GradientOrigin="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Offset="0" Color="#4A4F57" />
            <GradientStop Offset="0.7" Color="#23262B" />
            <GradientStop Offset="1" Color="#121417" />
        </RadialGradientBrush>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="300" Height="128">
            <Canvas x:Name="Waves" Visibility="Collapsed">
                <Path x:Name="WaveR1" Data="M210 64a24 24 0 0 1 0 36" Stroke="#B48CFF" Opacity="0.78" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WaveR2" Data="M224 56a34 34 0 0 1 0 52" Stroke="#8A5BE0" Opacity="0.56" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WaveR3" Data="M238 48a44 44 0 0 1 0 68" Stroke="#5CB8FF" Opacity="0.34" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WaveL1" Data="M90 64a24 24 0 0 0 0 36" Stroke="#B48CFF" Opacity="0.78" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WaveL2" Data="M76 56a34 34 0 0 0 0 52" Stroke="#8A5BE0" Opacity="0.56" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WaveL3" Data="M62 48a44 44 0 0 0 0 68" Stroke="#5CB8FF" Opacity="0.34" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
            <!-- cabinet -->
            <Rectangle Canvas.Left="120" Canvas.Top="8" Width="60" Height="112" RadiusX="10" RadiusY="10" Stroke="#4A4E55" StrokeThickness="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#3A3D44" />
                        <GradientStop Offset="1" Color="#1C1E22" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- tweeter -->
            <Ellipse Canvas.Left="138" Canvas.Top="22" Width="24" Height="24" Fill="{StaticResource Cone}" Stroke="#2C3036" StrokeThickness="2" />
            <Ellipse Canvas.Left="146" Canvas.Top="30" Width="8" Height="8" Fill="#5A5F67" />
            <!-- woofer: moves with the bass -->
            <Grid x:Name="Woofer" Canvas.Left="126" Canvas.Top="58" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="WooferScale" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource Cone}" Stroke="#2C3036" StrokeThickness="3" />
                <Ellipse Width="16" Height="16" Fill="#5A5F67" />
                <Ellipse Width="5" Height="5" Fill="#40FFFFFF" Margin="0,0,8,8" />
            </Grid>
            <Ellipse x:Name="Led" Canvas.Left="168.4" Canvas.Top="112.4" Width="3.2" Height="3.2" Fill="#5A6068" />
        </Canvas>
    </Viewbox>
</UserControl>
