<?xml version="1.0" encoding="utf-8"?>
<!-- A wall air conditioner seen from the front: the display shows the target temperature, the louvre opens
     and cool air flows out of the outlet while it runs. Drawn on a 300 × 128 canvas. -->
<UserControl
    x:Class="LedControl.Art.AcFrontArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Name="Flow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Wind1" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-14" Duration="0:0:1.1" EnableDependentAnimation="True" />
            <DoubleAnimation Storyboard.TargetName="Wind2" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-14" Duration="0:0:1.1" EnableDependentAnimation="True" />
            <DoubleAnimation Storyboard.TargetName="Wind3" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-14" Duration="0:0:1.1" EnableDependentAnimation="True" />
        </Storyboard>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="300" Height="128">
            <!-- the air: a soft beam and three moving wind lines -->
            <Canvas x:Name="Air">
                <Path Data="M66 82 L40 128 H260 L234 82 Z">
                    <Path.Fill>
                        <LinearGradientBrush x:Name="AirBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#BFCFEAFF" />
                            <GradientStop Offset="1" Color="#00CFEAFF" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path x:Name="Wind1" Data="M110 86c-5 10 5 16 0 26c-3 6 0 10 0 14" Stroke="#99FFFFFF" StrokeThickness="2" StrokeDashArray="3,4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" />
                <Path x:Name="Wind2" Data="M150 86c-5 10 5 16 0 26c-3 6 0 10 0 14" Stroke="#99FFFFFF" StrokeThickness="2" StrokeDashArray="3,4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" />
                <Path x:Name="Wind3" Data="M190 86c-5 10 5 16 0 26c-3 6 0 10 0 14" Stroke="#99FFFFFF" StrokeThickness="2" StrokeDashArray="3,4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" />
            </Canvas>
            <!-- body -->
            <Rectangle Canvas.Left="46" Canvas.Top="14" Width="208" Height="64" RadiusX="16" RadiusY="16" Stroke="#CDD2D7" StrokeThickness="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="White" />
                        <GradientStop Offset="0.7" Color="#F1F3F5" />
                        <GradientStop Offset="1" Color="#DDE1E5" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Path Data="M64 22h172M64 26h172M64 30h172" Stroke="#C9CED4" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M52 56h196" Stroke="#D3D8DD" StrokeThickness="1" />
            <!-- display and power light -->
            <Rectangle Canvas.Left="206" Canvas.Top="36" Width="34" Height="15" RadiusX="4" RadiusY="4" Fill="#1E2730" />
            <TextBlock x:Name="Display" Canvas.Left="206" Canvas.Top="36.5" Width="34" TextAlignment="Center"
                       FontSize="9.5" FontWeight="SemiBold" Foreground="#6FD3FF" Text="--" />
            <Ellipse x:Name="Led" Canvas.Left="196.2" Canvas.Top="41.7" Width="3.6" Height="3.6" Fill="#5A6068" />
            <!-- outlet on the lower front, with the louvre blade -->
            <Path Data="M54 62H246V68A10 10 0 0 1 236 78H64A10 10 0 0 1 54 68Z" Fill="#2B3138" />
            <Rectangle x:Name="Blade" Canvas.Left="62" Canvas.Top="66" Width="176" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#E4E7EA" />
        </Canvas>
    </Viewbox>
</UserControl>
