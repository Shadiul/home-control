<?xml version="1.0" encoding="utf-8"?>
<!-- The quick panel that opens above the notification area: a tab per device, a picture of it lit by its
     state with its name, status and a big power button, then its controls on a soft wash of its colour,
     and a footer to open the app or Settings. -->
<Window
    x:Class="LedControl.Shell.QuickPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Home Control">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- One tab per device -->
        <Grid x:Name="Tabs" Padding="12,12,12,8" ColumnSpacing="4" AutomationProperties.Name="Devices" />

        <!-- The control area takes a soft wash of the device's colour, so it feels lit by the device -->
        <Border x:Name="Wash" Grid.Row="1" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="14,4,14,14" Spacing="10">
                <!-- The device, lit by its current state; name, state and a big power button along the bottom -->
                <Grid x:Name="Stage" Height="150" CornerRadius="14">
                    <Border x:Name="StageBase" />
                    <Border x:Name="StageGlow" />
                    <ContentPresenter x:Name="ArtHost" HorizontalAlignment="Center" />
                    <Grid VerticalAlignment="Bottom" Padding="14,28,12,10" ColumnSpacing="12">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#9E000000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="StageName" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StageStatus" FontSize="12" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="PowerButton" Grid.Column="1" Style="{StaticResource BareButton}" Width="44" Height="44"
                                CornerRadius="22" VerticalAlignment="Bottom" Click="Power_Click">
                            <Grid>
                                <Ellipse Width="60" Height="60" Margin="-8,-4,-8,-12" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#40000000" />
                                            <GradientStop Offset="0.7" Color="#1A000000" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border x:Name="PowerFace" CornerRadius="22" BorderThickness="1">
                                    <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="18" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Air conditioners: the target temperature on a tile, with big − and + either side -->
                <Grid x:Name="TempRow" Height="64" Padding="8,0" CornerRadius="14" BorderThickness="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TempDown" Width="48" Height="48" CornerRadius="12" Padding="0" BorderThickness="0" Click="TempDown_Click"
                            AutomationProperties.Name="Lower temperature" ToolTipService.ToolTip="Lower temperature">
                        <FontIcon Glyph="&#xE738;" FontSize="16" />
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TempValue" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" LineHeight="36" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="TempCaption" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="TempUp" Grid.Column="2" Width="48" Height="48" CornerRadius="12" Padding="0" BorderThickness="0" Click="TempUp_Click"
                            AutomationProperties.Name="Raise temperature" ToolTipService.ToolTip="Raise temperature">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- The device's fill sliders, then its groups of tiles -->
                <StackPanel x:Name="Controls" Spacing="10" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: how the devices are doing, and buttons to open the app or Settings -->
        <Grid Grid.Row="2" Padding="16,0,8,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="FooterDot" Width="8" Height="8" />
                <TextBlock x:Name="FooterText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="Open_Click"
                        AutomationProperties.Name="Open Home Control" ToolTipService.ToolTip="Open Home Control">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="Settings_Click"
                        AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
